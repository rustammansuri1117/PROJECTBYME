PORT=5000

# PostgreSQL connection (either use DATABASE_URL or the individual DB_* values)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/hotel_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=hotel_db

# Allowed frontend origin(s), comma separated
CORS_ORIGIN=http://localhost:5173
